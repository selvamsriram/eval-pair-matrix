# Keep real keys in .env. Never commit .env.

# Azure OpenAI Responses API example
AZURE_GPT_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_GPT_API_KEY=
AZURE_GPT_API_VERSION=2025-03-01-preview
AZURE_GPT_MODEL=gpt-5.x

# Azure Foundry /models/chat/completions OpenAI-compatible (Kimi)
AZURE_KIMI_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AZURE_KIMI_API_KEY=
AZURE_KIMI_MODEL=kimi-k2.x

# Azure Foundry /models/chat/completions OpenAI-compatible (Grok)
AZURE_GROK_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AZURE_GROK_API_KEY=
AZURE_GROK_MODEL=grok-4.3

# Anthropic direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-x
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-x

# Google Gemini (3.5 Flash via google-genai SDK).
# Either set GEMINI_API_KEY (Developer API / Vertex Express)
# OR set GOOGLE_CLOUD_PROJECT for Vertex AI with ADC (requires
#   `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Only used in Vertex/ADC mode:
GOOGLE_CLOUD_PROJECT=
GEMINI_VERTEX_LOCATION=global

# Third-party perturbation / style model examples
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

