# Keep real keys in .env. Never commit .env.

# Azure OpenAI Responses API example
AZURE_GPT_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_GPT_API_KEY=
AZURE_GPT_API_VERSION=2025-03-01-preview
AZURE_GPT_MODEL=gpt-5.x

# Azure Foundry /models/chat/completions OpenAI-compatible example
AZURE_KIMI_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AZURE_KIMI_API_KEY=
AZURE_KIMI_MODEL=kimi-k2.x

# Anthropic direct example
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-x
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-x

# Google Gemini direct example
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro

# Third-party perturbation / style model examples
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

